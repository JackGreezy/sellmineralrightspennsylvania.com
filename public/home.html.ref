img { max-width: 100%; max-height: 100%; }
.img-fluid { object-fit: cover; }
body { background-color: rgb(255, 255, 255); color: rgb(32, 32, 32); font-size: clamp(14px, 0.833333vw, 16px); font-family: Inter, sans-serif; }
* { outline: 0px; }
::selection { background-color: rgb(14, 129, 112); color: rgb(255, 255, 255); }
::-webkit-input-placeholder { color: rgb(32, 32, 32); opacity: 0.8; }
h1 { font-size: clamp(50px, 5.20833vw, 100px); font-weight: 700; line-height: 1; margin-bottom: 0.35em; font-family: Inter, sans-serif; letter-spacing: -0.025em; }
.h2, h2 { letter-spacing: -0.035em; font-weight: 800; font-size: clamp(30px, 3.125vw, 60px); line-height: 1; margin-bottom: 0.35em; font-family: Inter, sans-serif; }
.h3, h3 { font-size: clamp(21px, 1.5625vw, 30px); font-weight: 800; line-height: 1.1; margin-bottom: 0.5em; font-family: Inter, sans-serif; }
.h4 { font-size: clamp(14px, 1.09375vw, 21px); font-family: Inter, sans-serif; font-weight: 800; margin-bottom: 0.75em; }
.h5 { font-size: clamp(13px, 0.9375vw, 18px); font-family: Inter, sans-serif; font-weight: 700; }
.container { max-width: 1920px; padding-left: clamp(35px, 7.44792vw, 143px); padding-right: clamp(35px, 7.44792vw, 143px); }
.button, .far, a, button, button[type="submit"], input, label { transition: color 0.2s ease-in-out, background-color 0.2s ease-in-out, border-color 0.2s ease-in-out, opacity 0.2s ease-in-out; text-decoration: none; }
button, input, select, textarea { font-family: Inter, sans-serif; line-height: normal; outline: 0px !important; }
input[type="submit"] { appearance: none; }
input[type="email"], input[type="number"], input[type="search"], input[type="text"], select, textarea { width: 100%; font-family: Inter, sans-serif; font-size: clamp(14px, 0.833333vw, 16px); font-weight: 400; border: 1px solid rgb(224, 224, 224); border-radius: 8px; padding: 13px 23px; background-color: rgb(255, 255, 255); color: rgb(32, 32, 32); transition: color 0.3s ease-in-out, background-color 0.3s ease-in-out, border-color 0.3s ease-in-out; line-height: 22px !important; }
.wrapper { width: 100%; }
.page-body > :last-child { margin-bottom: 0px; }
select { appearance: none; background-image: url("data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14.234\" height=\"7.117\" viewBox=\"0 0 14.234 7.117\"><path id=\"Icon_ionic-md-arrow-dropdown\" data-name=\"Icon ionic-md-arrow-dropdown\" d=\"M9,13.5l7.117,7.117L23.234,13.5Z\" transform=\"translate(-9 -13.5)\" fill=\"%23231f20\"/></svg>"); background-repeat: no-repeat; background-position: right 20px center; padding-right: 45px !important; }
textarea { height: 140px; display: block; resize: none; }
a { color: rgb(0, 85, 165); }
a:hover { color: rgb(3, 55, 104); }
b { font-weight: 700; }
ol, p, ul { margin-bottom: 25px; }
input[type="search"]::-webkit-search-cancel-button, input[type="search"]::-webkit-search-decoration, input[type="search"]::-webkit-search-results-button, input[type="search"]::-webkit-search-results-decoration { display: none; }
.img-bg { position: relative; display: block; }
.img-bg img { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; object-fit: cover; }
body { --body-padding-top: 90px; padding-top: var(--body-padding-top); }
@media (max-width: 991px) {
  .container { padding-left: 35px; padding-right: 35px; }
  html[lang*="-"] { margin-top: 0px !important; }
  body { --body-padding-top: 78px; }
}
.navbar { background-color: rgb(63, 119, 172); padding: 0px; min-height: var(--body-padding-top); transition: 0.3s ease-in-out; box-shadow: rgba(0, 0, 0, 0.16) 0px 6px 6px; position: fixed; top: 0px; left: 0px; z-index: 99; width: 100%; }
.navbar .container-fluid { padding-left: clamp(25px, 2.34375vw, 45px); padding-right: clamp(20px, 2.34375vw, 45px); }
.navbar .logo { position: relative; z-index: 102; width: clamp(185px, 12.8125vw, 246px); }
.navbar .logo img { width: 100%; transition: opacity 0.3s ease-in-out; }
.navbar-toggler { width: 33px; height: 25px; padding: 0px; display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-end; box-shadow: none; transition: 0.3s linear; border-radius: 0px; z-index: 99; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; position: relative; }
.navbar-toggler:focus { box-shadow: none; }
.navbar-toggler .icon-bar { display: block; height: 5px; background: rgb(255, 255, 255); width: 100%; opacity: 1; border-radius: 5px; transition: 0.2s linear; transform-origin: 50% 50%; }
.navbar-toggler .icon-bar + .icon-bar { margin-top: 5px; }
.navbar-toggler .icon-bar:nth-child(2) { width: 17px; }
.navbar-toggler .icon-bar:nth-child(3) { width: 9px; }
.navbar-toggler.collapsed .icon-bar { opacity: 1; transform: rotate(0deg) translate3d(0px, 0px, 0px); }
.navbar-close { position: absolute; right: 20px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; background: 0px 0px; color: rgb(255, 255, 255); padding: 0px; top: 30px; z-index: 102; }
.navbar-collapse { position: relative; z-index: 100; }
@media (max-width: 1199px) and (max-width: 991px) {
  .navbar-collapse-content { display: flex; flex-direction: column; }
}
.navbar-phone { color: rgb(255, 255, 255); text-transform: uppercase; margin-left: clamp(24px, 1.5625vw, 30px); letter-spacing: 0.5px; font-size: clamp(13px, 0.885417vw, 17px); }
.navbar-phone a { color: rgb(255, 255, 255); display: flex; align-items: center; }
.navbar-phone a .icon-phone { color: rgb(0, 227, 195); margin-right: 10px; }
.navbar-nav { align-items: center; }
.navbar-nav > li { position: relative; }
.navbar-nav > li.navbar-button { padding-top: 0px; padding-bottom: 0px; }
@media (max-width: 1199px) and (min-width: 768px) {
  .navbar-nav > li.navbar-button { margin-top: 60px; }
}
@media (min-width: 1200px) {
  .navbar-nav > li.navbar-button + .navbar-button { margin-left: clamp(24px, 1.5625vw, 30px); }
}
@media (max-width: 1199px) {
  .navbar .container-fluid { padding-left: 20px; padding-right: 20px; }
  .navbar-collapse { background: rgb(63, 119, 172); position: absolute; left: 0px; top: 0px; width: 100%; box-shadow: rgba(0, 0, 0, 0.1) 0px 10px 7px; padding: 0px; }
  .navbar-collapse-content { height: 100vh; padding: 100px 35px 30px; overflow: auto; }
  .navbar-phone { margin-top: 40px; margin-left: 0px; }
  .navbar-nav { flex-flow: wrap; }
