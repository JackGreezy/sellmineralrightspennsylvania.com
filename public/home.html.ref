  .navbar-nav > li.navbar-button { flex: 0 0 48%; }
}
@media (max-width: 767px) {
  textarea { height: 120px; }
  .navbar-nav > li.navbar-button + .navbar-button { margin-top: 15px; }
  .navbar-nav > li.navbar-button { flex: 0 0 100%; }
  .navbar-nav > li.navbar-button#menu-item-117 { margin-top: 60px; }
}
.navbar-nav > li.navbar-button > a { background: rgb(14, 129, 112); font-family: Inter, sans-serif; text-transform: uppercase; display: flex; align-items: center; justify-content: center; border-radius: 8px; text-decoration: none; line-height: 20px; padding: 15px 25px; color: rgb(255, 255, 255); text-align: center; position: relative; z-index: 1; white-space: nowrap; overflow: hidden; font-size: clamp(12px, 0.78125vw, 15px); font-weight: 700; }
