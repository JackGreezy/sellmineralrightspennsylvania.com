(function () {
  function fixWidgets() {
    /* Move accessiBe button inside open shadow roots */
    document.querySelectorAll('*').forEach(function (host) {
      if (!host.shadowRoot) return;

      const acsbBtn = host.shadowRoot.querySelector('[part="acsb-trigger"], .trigger-button');
      if (acsbBtn) {
        acsbBtn.style.setProperty('left', '20px', 'important');
        acsbBtn.style.setProperty('right', 'auto', 'important');
        acsbBtn.classList.remove('position-x-right');
        acsbBtn.classList.add('position-x-left');
      }

      const consentBanner = host.shadowRoot.querySelector(
        '#wpconsent-banner, .wpconsent-banner, [class*="wpconsent"][class*="banner"]'
      );

      if (consentBanner) {
        consentBanner.style.setProperty('width', '80%', 'important');
        consentBanner.style.setProperty('max-width', '80%', 'important');
        consentBanner.style.setProperty('left', '50%', 'important');
        consentBanner.style.setProperty('right', 'auto', 'important');
        consentBanner.style.setProperty('bottom', '0', 'important');
        consentBanner.style.setProperty('transform', 'translateX(-50%)', 'important');
      }
    });
  }

  fixWidgets();
  window.addEventListener('load', fixWidgets);

  new MutationObserver(fixWidgets).observe(document.documentElement, {
    childList: true,
    subtree: true,
    attributes: true,
    attributeFilter: ['class', 'style']
  });
})();
