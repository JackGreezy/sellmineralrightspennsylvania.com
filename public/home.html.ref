        var data = {
            name: $(this).find('.y-name input').val(),
            phone: $(this).find('.y-phone input').val(),
            email: $(this).find('.y-email input').val(),
      address: $(this).find('.y-address input').val(),
            city: $(this).find('.y-city input').val(),
            state: $(this).find('.y-state select').val(),
            zip: $(this).find('.y-service input').val(),
      country: $(this).find('.y-country select').val(),
            message: $(this).find('.y-message textarea').val(),

            page_url: window.location.href,
        }

        $.ajax({
            url: 'https://puretecwater.com/wp-admin/admin-ajax.php',
            type: 'post',
            dataType: 'json',
            data: { 'action' : 'partial_leads', 'data': data },
            success: function ( response ) {
                console.log( response );
            },
        });


    });

})(jQuery);
