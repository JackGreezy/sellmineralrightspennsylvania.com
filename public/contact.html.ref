.menu-item i._mi, .menu-item img._mi { display: inline-block; vertical-align: middle; }
.menu-item i._mi { width: auto; height: auto; margin-top: -0.265em; font-size: 1.2em; line-height: 1; }
.menu-item i._before { margin-right: 0.25em; }
.rtl .menu-item i._before { margin-left: 0.25em; }
.menu-item img._before { margin-right: 0.5em; }
